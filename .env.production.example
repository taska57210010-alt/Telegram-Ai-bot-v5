# Production Environment Configuration
# Copy to .env and fill in your values

# ============ Telegram Configuration ============
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_PAYMENT_PROVIDER_TOKEN=

# ============ Webhook Configuration ============
WEBHOOK_ENABLED=true
WEBHOOK_DOMAIN=https://your-domain.com
WEBHOOK_SECRET=generate_random_secret_here
WEBHOOK_PORT=8080

# ============ Database Configuration ============
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_strong_password_here
DATABASE_URL=postgresql+asyncpg://postgres:your_password@postgres:5432/telegram_bot

# ============ Redis Configuration ============
REDIS_URL=redis://redis:6379/0

# ============ OpenRouter API ============
OPENROUTER_API_KEY=your_openrouter_key_here

# ============ Monitoring ============
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=production

# ============ Admin ============
ADMIN_USER_IDS=123456789,987654321

# ============ Grafana ============
GRAFANA_PASSWORD=generate_strong_password_here

# ============ Rate Limiting ============
RATE_LIMIT_QUESTIONS_PER_MINUTE=5
RATE_LIMIT_QUESTIONS_PER_HOUR=20
RATE_LIMIT_QUESTIONS_PER_DAY=100
